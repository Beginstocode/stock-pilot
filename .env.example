# Backend identity and local development
APP_NAME=StockPilot AI
APP_VERSION=1.0.0
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local SQLite database. Replace with a PostgreSQL SQLAlchemy URL as needed.
DATABASE_URL=sqlite:///./stockpilot.db
JWT_SECRET_KEY=GENERATE_A_PRIVATE_RANDOM_VALUE_BEFORE_USE
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Project assets and paths
MODEL_PATH=models/xgboost_model.pkl
DATA_DIR=data
PROCESSED_DATA_DIR=data/processed
REPORTS_DIR=reports

# FinBERT (model weights are fetched from Hugging Face on first use)
FINBERT_MODEL_NAME=ProsusAI/finbert
FINBERT_DEVICE=

# Optional OpenAI-compatible business-impact analysis provider
NEWS_IMPACT_LLM_URL=
NEWS_IMPACT_LLM_API_KEY=
NEWS_IMPACT_LLM_MODEL=
NEWS_IMPACT_LLM_TIMEOUT_SECONDS=25

# Persistent historical outcome worker
NEWS_OUTCOME_WORKER_ENABLED=true
NEWS_OUTCOME_WORKER_INTERVAL_SECONDS=3600
NEWS_OUTCOME_WORKER_LOCK_PATH=data/processed/.news_outcome_worker.lock
